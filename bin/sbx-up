#!/usr/bin/env bash
# sbx-up - start a project's sandbox, built from this repo's base kits plus the project's own mixins.
#
# Run on the host (where sbx is), from a project directory. Put this repo's bin/ on PATH, or
# symlink this file into a directory on PATH; it finds the repo through its own location.
#
#   sbx-up [-n] [-r] shell  [PATH] [-- ARGS...]   shell-base + the project's .sbx-kits/ mixins, opens fish
#   sbx-up [-n] [-r] claude [PATH] [-- ARGS...]   ... + Docker's claude-mixin, starts Claude Code
#   sbx-up [-n] [-r] opencode [PATH] [-- ARGS...] ... + Docker's opencode-mixin, starts OpenCode
#   sbx-up [-n] [-r] sealed [-k] [-c NAME] shell|claude|opencode [-- ARGS...]
#                                            throwaway sandbox sealed-<flavor>, or
#                                            sealed-<flavor>-NAME with -c: an empty workspace, no
#                                            project mixins; sbx removes the sandbox when the
#                                            session ends (sbx run --rm), unless -k keeps it
#   sbx-up [-n] kit [PATH]                   copy project-template/.sbx-kits/ into a project
#
#   PATH   project directory, mounted as the workspace (default: current directory); for kit, the
#          project to copy the template into
#   ARGS   appended to the workload's launch command (`bash -l`); they replace the defaults
#          `-lc 'exec fish -l'` for shell, `-lc 'claude --permission-mode auto'` for claude
#          (claude-mixin seeds settings.json with defaultMode bypassPermissions; the flag starts the
#          session in auto mode instead) and OpenCode's binary for opencode (see below). `sbx-up shell -- -l` opens bash instead of fish.
#   -n     print the commands instead of running them
#   -r     rebuild: remove an existing sandbox of the same name and create it from the current kits
#          (for sealed only matters with -k; without it sealed always starts fresh)
#   -c     sealed only: name the sandbox, so several sealed sandboxes of one flavor can run at once
#          (`sbx-up sealed -c test claude` => sealed-claude-test, workspace ~/.cache/sbx-up/sealed-claude-test)
#   -k     sealed only: keep the sandbox and its workspace when the session ends; the next
#          `sbx-up sealed -k` with the same flavor and name reattaches to it like shell|claude|opencode
#          do. A later sealed start without -k still removes it and empties the workspace.
#
# Before starting, every run copies config/skills/ into the skills folder sbx mounts into all
# sandboxes (bin/install-skills; only changed skills are copied). Then, if the host has a
# `lockconfig` command on PATH, it runs that; sbx-up stops if lockconfig fails.
#
# shell, claude and opencode reuse an existing sandbox of the same name (`sbx run --name`, which restarts
# it if stopped) and only create one when none exists. sbx keeps the kits a sandbox was created
# with, so after changes to shell-base, <flavor>-mixin.ref or .sbx-kits/ run with -r: that removes
# the sandbox first, and anything installed by hand inside it is gone (put it in .sbx-kits/).
# sealed always creates a fresh sandbox, except with -k, which reuses a kept one.
#
# Project mixins: every .sbx-kits/<name>/ directory that holds <name>.yaml is added with --kit, in
# alphabetical order. See project-template/ for a starting point; `sbx-up kit` copies it and
# leaves mixins the project already has alone.
#
# Example: in ~/projects/shop with .sbx-kits/project/project.yaml, `sbx-up claude` runs
#   sbx run --name shop-claude -- -lc 'claude --permission-mode auto'      (if shop-claude exists)
# and otherwise, or always with -r,
#   sbx rm -f shop-claude                                  (only if it exists)
#   sbx run --name shop-claude \
#     --kit docker/sbx-kit-claude-mixin:2.1.285@sha256:52a5... \
#     --kit /Users/me/projects/shop/.sbx-kits/project \
#     /path/to/sandbox-templates/shell-base /Users/me/projects/shop \
#     -- -lc 'claude --permission-mode auto'
# and `sbx-up sealed claude` runs the same without the project kit, named sealed-claude, on an
# empty ~/.cache/sbx-up/sealed-claude, with --rm so sbx removes it once Claude Code exits.
set -eo pipefail

usage() {
  sed -n '2,/^set -eo/{/^set -eo/d;s/^# \{0,1\}//;p;}' "$0" >&2
  exit "${1:-2}"
}

# Follows symlinks to this script, then returns the repo root (the parent of bin/).
#   /usr/local/bin/sbx-up -> ~/projects/sandbox-templates/bin/sbx-up
#   => ~/projects/sandbox-templates
repo_root() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")/.." && pwd
}

# Turns a string into a valid part of an sbx sandbox name (letters, digits, hyphens and periods,
# starting with a letter or digit); prints nothing if no such character is left.
#   My Shop_2  =>  my-shop-2
slug() {
  printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9.\n-' '-' | sed 's/^[^a-z0-9]*//; s/-\{2,\}/-/g; s/-$//'
}

# Turns a project directory and flavor into a valid sbx sandbox name.
#   /Users/me/projects/My Shop_2, claude  =>  my-shop-2-claude
sandbox_name() {
  local base
  base="$(slug "$(basename "$1")")"
  [ -n "$base" ] || base="project"
  printf '%s-%s\n' "$base" "$2"
}

run() {
  if [ -n "$DRY_RUN" ]; then
    printf '%q ' "$@"
    printf '\n'
  else
    "$@"
  fi
}

# Copies every mixin of project-template/.sbx-kits/ into a project's .sbx-kits/, skipping the ones
# the project already has.
#   copy_template ~/projects/shop   => ~/projects/shop/.sbx-kits/project/project.yaml
copy_template() {
  local project="$1" src="$REPO/project-template/.sbx-kits" dir name copied=""
  [ -d "$project" ] || { echo "sbx-up: not a directory: $project" >&2; exit 1; }
  project="$(cd -P "$project" && pwd)"
  for dir in "$src"/*/; do
    [ -d "$dir" ] || continue
    dir="${dir%/}"
    name="$(basename "$dir")"
    if [ -e "$project/.sbx-kits/$name" ]; then
      echo "sbx-up: $project/.sbx-kits/$name exists, left alone" >&2
      continue
    fi
    run mkdir -p "$project/.sbx-kits"
    run cp -R "$dir" "$project/.sbx-kits/$name"
    copied=1
  done
  if [ -n "$copied" ] && [ -z "$DRY_RUN" ]; then
    echo "sbx-up: copied the template to $project/.sbx-kits/" >&2
    echo "sbx-up: edit .sbx-kits/*/*.yaml, commit it with the project, then run sbx-up shell|claude" >&2
  fi
}

DRY_RUN=""
REBUILD=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n) DRY_RUN=1; shift ;;
    -r) REBUILD=1; shift ;;
    -h|--help) usage 0 ;;
    *) break ;;
  esac
done

REPO="$(repo_root)"

SEALED=""
SEALED_NAME=""
SEALED_KEEP=""
case "${1:-}" in
  shell|claude|opencode)
    FLAVOR="$1"
    shift
    ;;
  sealed)
    SEALED=1
    shift
    while [ $# -gt 0 ]; do
      case "$1" in
        -c)
          [ $# -ge 2 ] || usage
          SEALED_NAME="$(slug "$2")"
          [ -n "$SEALED_NAME" ] || { echo "sbx-up: not a usable sandbox name: $2" >&2; exit 1; }
          shift 2
          ;;
        -k) SEALED_KEEP=1; shift ;;
        *) break ;;
      esac
    done
    FLAVOR="${1:-}"
    case "$FLAVOR" in shell|claude|opencode) shift ;; *) usage ;; esac
    ;;
  kit)
    shift
    [ $# -le 1 ] || usage
    copy_template "${1:-$PWD}"
    exit 0
    ;;
  *) usage ;;
esac

if [ -n "$SEALED" ]; then
  # A fixed, emptied directory instead of the project: nothing from the host is mounted.
  NAME="sealed-$FLAVOR${SEALED_NAME:+-$SEALED_NAME}"
  PROJECT="${XDG_CACHE_HOME:-$HOME/.cache}/sbx-up/$NAME"
else
  PROJECT="$PWD"
  if [ $# -gt 0 ] && [ "$1" != "--" ]; then
    PROJECT="$1"
    shift
  fi
  [ -d "$PROJECT" ] || { echo "sbx-up: not a directory: $PROJECT" >&2; exit 1; }
  PROJECT="$(cd -P "$PROJECT" && pwd)"
  NAME="$(sandbox_name "$PROJECT" "$FLAVOR")"
fi

ARGS=()
if [ $# -gt 0 ]; then
  [ "$1" = "--" ] || usage
  shift
  ARGS=("$@")
fi

KITS=()
if [ "$FLAVOR" = shell ]; then
  # bash -l first, so the login profile runs as before, then fish replaces it.
  [ ${#ARGS[@]} -gt 0 ] || ARGS=(-lc 'exec fish -l')
else
  # Each agent flavor adds Docker's mixin pinned in <flavor>-mixin.ref (claude-mixin.ref, ...).
  MIXIN_REF="$(grep -v '^[[:space:]]*\(#\|$\)' "$REPO/$FLAVOR-mixin.ref" | head -n 1)"
  [ -n "$MIXIN_REF" ] || { echo "sbx-up: no reference in $REPO/$FLAVOR-mixin.ref" >&2; exit 1; }
  KITS+=(--kit "$MIXIN_REF")
  if [ ${#ARGS[@]} -eq 0 ]; then
    case "$FLAVOR" in
      claude) ARGS=(-lc 'claude --permission-mode auto') ;;
      # opencode-mixin's /usr/local/bin/opencode runs `node .../opencode-ai/bin/opencode`, but the
      # package installs only the native Linux binary there, named opencode.exe, so start that
      # directly. Back to plain `opencode` once Docker fixes the launcher.
      opencode) ARGS=(-lc 'exec /opt/opencode/lib/node_modules/opencode-ai/bin/opencode.exe') ;;
    esac
  fi
fi

if [ -z "$SEALED" ] && [ -d "$PROJECT/.sbx-kits" ]; then
  for dir in "$PROJECT"/.sbx-kits/*/; do
    [ -d "$dir" ] || continue
    dir="${dir%/}"
    if [ -f "$dir/$(basename "$dir").yaml" ]; then
      KITS+=(--kit "$dir")
    else
      echo "sbx-up: skipping $dir (no $(basename "$dir").yaml inside)" >&2
    fi
  done
fi

# Keeps the skills sbx mounts into every sandbox in sync with config/skills/ (see bin/install-skills).
# A failure only warns: the sandbox still starts, just without updated skills.
"$REPO/bin/install-skills" -q ${DRY_RUN:+-n} >&2 || echo "sbx-up: could not install skills, continuing" >&2

# Host-specific lock step, set up outside this repo; skipped where the command doesn't exist. Unlike
# the skills, a failure stops sbx-up, so a sandbox never starts on an unlocked config.
if command -v lockconfig >/dev/null 2>&1; then
  run lockconfig || { echo "sbx-up: lockconfig failed, not starting the sandbox" >&2; exit 1; }
fi

EXISTS=""
if sbx ls -q 2>/dev/null | grep -qxF "$NAME"; then
  EXISTS=1
fi

# Reuse: `sbx run --name` restarts and attaches to the existing sandbox, reading its kits and
# workspace from the sandbox's spec. Kits are left out on purpose: passing a kit with build content
# would make sbx create the sandbox fresh. ARGS still go along, so `claude` starts Claude Code.
# sealed reuses only with -k; without it, a kept or left-behind sandbox is replaced below.
if [ -n "$EXISTS" ] && [ -z "$REBUILD" ] && { [ -z "$SEALED" ] || [ -n "$SEALED_KEEP" ]; }; then
  if [ -n "$SEALED" ]; then
    echo "sbx-up: reusing sandbox $NAME (sbx-up -r sealed -k ... to start it fresh)" >&2
  else
    echo "sbx-up: reusing sandbox $NAME (sbx-up -r $FLAVOR to rebuild it from the current kits)" >&2
  fi
  CMD=(sbx run --name "$NAME")
  [ ${#ARGS[@]} -eq 0 ] || CMD+=(-- "${ARGS[@]}")
  if [ -n "$DRY_RUN" ]; then
    run "${CMD[@]}"
    exit 0
  fi
  exec "${CMD[@]}"
fi

if [ -n "$EXISTS" ]; then
  echo "sbx-up: removing existing sandbox $NAME" >&2
  run sbx rm -f "$NAME"
fi

CMD=(sbx run --name "$NAME")
# sealed: --rm (sbx 0.47.0+) removes the sandbox once the agent session exits; -k leaves it out so
# the sandbox stays for the next `sealed -k`. sbx-up still execs sbx, since tmux/agent.conf tells
# sandbox panes apart by their foreground process being `sbx`. A sandbox left behind by an
# interrupted run is removed above on the next sealed start, and the workspace is emptied here
# before each fresh start.
[ -z "$SEALED" ] || [ -n "$SEALED_KEEP" ] || CMD+=(--rm)
[ ${#KITS[@]} -eq 0 ] || CMD+=("${KITS[@]}")
CMD+=("$REPO/shell-base" "$PROJECT")
[ ${#ARGS[@]} -eq 0 ] || CMD+=(-- "${ARGS[@]}")

if [ -n "$SEALED" ]; then
  run rm -rf "${PROJECT:?}"
  run mkdir -p "$PROJECT"
fi

if [ -n "$DRY_RUN" ]; then
  run "${CMD[@]}"
else
  exec "${CMD[@]}"
fi
