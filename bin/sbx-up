#!/usr/bin/env bash
# sbx-up - start a project's sandbox, built from this repo's base kits plus the project's own mixins.
#
# Run on the host (where sbx is), from a project directory. Put this repo's bin/ on PATH, or
# symlink this file into a directory on PATH; it finds the repo through its own location.
#
#   sbx-up [-n] [-r] [-y] shell  [PATH] [-- ARGS...]   shell-base + the project's .sbx-kits/ mixins, opens bash
#   sbx-up [-n] [-r] [-y] claude [PATH] [-- ARGS...]   ... + Docker's claude-mixin, starts Claude Code
#   sbx-up [-n] [-r] [-y] sealed [-k] [-c NAME] shell|claude [-- ARGS...]
#                                            throwaway sandbox sealed-<flavor>, or
#                                            sealed-<flavor>-NAME with -c: an empty workspace, no
#                                            project mixins; sbx removes the sandbox when the
#                                            session ends (sbx run --rm), unless -k keeps it
#   sbx-up [-n] kit [PATH]                   copy project-template/.sbx-kits/ into a project
#   sbx-up [-n] unlock [PATH]                make the locked project files writable again (see below)
#
#   PATH   project directory, mounted as the workspace (default: current directory); for kit and
#          unlock, the project to act on. For kit, the
#          project to copy the template into
#   ARGS   appended to the workload's launch command (`bash -l`); they replace the defaults
#          `-l` (a login bash) for shell, `-lc 'claude --permission-mode auto'` for claude
#          (claude-mixin seeds settings.json with defaultMode bypassPermissions; the flag starts the
#          session in auto mode instead).
#   -n     print the commands instead of running them (no prompt)
#   -y     start without asking: by default sbx-up shows the sandbox, the directory it mounts and
#          the kits it applies, and waits for a y on the terminal. Required when there is no
#          terminal to ask on.
#   -r     rebuild: remove an existing sandbox of the same name and create it from the current kits
#          (for sealed only matters with -k; without it sealed always starts fresh)
#   -c     sealed only: name the sandbox, so several sealed sandboxes of one flavor can run at once
#          (`sbx-up sealed -c test claude` => sealed-claude-test, workspace ~/.cache/sbx-up/sealed-claude-test)
#   -k     sealed only: keep the sandbox and its workspace when the session ends; the next
#          `sbx-up sealed -k` with the same flavor and name reattaches to it like shell|claude
#          do. A later sealed start without -k still removes it and empties the workspace.
#
# Before anything changes (sandbox removal, emptying a sealed workspace, locking, sbx), sbx-up
# asks for confirmation, e.g.:
#   sandbox  shop-claude (create)
#   mounts   ~/projects/shop
#   kits     ~/projects/sandbox-templates/shell-base
#            sbx/claude-mixin:2.1.330@sha256:ae80...
#            ~/projects/shop/.sbx-kits/project
#   locks    .git/hooks .git/config .sbx-kits
#   Start? [y/N]
# A reused sandbox keeps the kits it was created with, so the prompt says so instead of listing them.
#
# Before starting shell or claude, sbx-up makes the project files that the host trusts read-only
# with macOS's user immutable flag (chflags -R uchg): .git/hooks and .git/config, which git on the
# host would run or obey, and .sbx-kits/, which the next sandbox is built from. The flag holds
# through the sandbox's mount, so nothing inside the sandbox can change them. git on the host can't
# write them either (e.g. `git config`, `git push -u`); `sbx-up unlock` clears the flag for that,
# and the next sbx-up start sets it again. If chflags fails, sbx-up doesn't start the sandbox.
# The agent skills in shell-base/skills/ ship inside shell-base (agent-skill@1), so they change
# with a rebuild (-r), like the rest of the kit.
#
# shell and claude reuse an existing sandbox of the same name (`sbx run --name`, which restarts it
# if stopped) and only create one when none exists. sbx keeps the kits a sandbox was created
# with, so after changes to shell-base, claude-mixin.ref or .sbx-kits/ run with -r: that removes
# the sandbox first, and anything installed by hand inside it is gone (put it in .sbx-kits/).
# sealed always creates a fresh sandbox, except with -k, which reuses a kept one.
#
# Project mixins: every .sbx-kits/<name>/ directory that holds <name>.yaml is added with --kit, in
# alphabetical order. See project-template/ for a starting point; `sbx-up kit` copies it and
# leaves mixins the project already has alone.
#
# Example: in ~/projects/shop with .sbx-kits/project/project.yaml, `sbx-up claude` runs
#   sbx run --name shop-claude -- -lc 'claude --permission-mode auto'      (if shop-claude exists)
# and otherwise, or always with -r,
#   sbx rm -f shop-claude                                  (only if it exists)
#   sbx run --name shop-claude \
#     --kit sbx/claude-mixin:2.1.330@sha256:ae80... \
#     --kit /Users/me/projects/shop/.sbx-kits/project \
#     /path/to/sandbox-templates/shell-base /Users/me/projects/shop \
#     -- -lc 'claude --permission-mode auto'
# and `sbx-up sealed claude` runs the same without the project kit, named sealed-claude, on an
# empty ~/.cache/sbx-up/sealed-claude, with --rm so sbx removes it once Claude Code exits.
set -eo pipefail

usage() {
  sed -n '2,/^set -eo/{/^set -eo/d;s/^# \{0,1\}//;p;}' "$0" >&2
  exit "${1:-2}"
}

# Follows symlinks to this script, then returns the repo root (the parent of bin/).
#   /usr/local/bin/sbx-up -> ~/projects/sandbox-templates/bin/sbx-up
#   => ~/projects/sandbox-templates
repo_root() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")/.." && pwd
}

# Turns a string into a valid part of an sbx sandbox name (letters, digits, hyphens and periods,
# starting with a letter or digit); prints nothing if no such character is left.
#   My Shop_2  =>  my-shop-2
slug() {
  printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9.\n-' '-' | sed 's/^[^a-z0-9]*//; s/-\{2,\}/-/g; s/-$//'
}

# Turns a project directory and flavor into a valid sbx sandbox name.
#   /Users/me/projects/My Shop_2, claude  =>  my-shop-2-claude
sandbox_name() {
  local base
  base="$(slug "$(basename "$1")")"
  [ -n "$base" ] || base="project"
  printf '%s-%s\n' "$base" "$2"
}

# Project files the host trusts, relative to the project: git runs the hooks and obeys the config,
# and sbx-up builds the next sandbox from .sbx-kits/. Locked before every start (set_lock).
LOCK_PATHS=(.git/hooks .git/config .sbx-kits)

# Prints the LOCK_PATHS that exist in a project, one per line.
#   ~/projects/shop (a git repo without .sbx-kits/)  =>  .git/hooks
#                                                         .git/config
existing_lock_paths() {
  local path
  for path in "${LOCK_PATHS[@]}"; do
    [ ! -e "$1/$path" ] || printf '%s\n' "$path"
  done
}

# Sets (uchg) or clears (nouchg) macOS's user immutable flag on a project's LOCK_PATHS; exits when
# chflags is missing or fails, so a sandbox never starts on writable files.
#   set_lock uchg ~/projects/shop   =>  chflags -R uchg .git/hooks .git/config .sbx-kits
set_lock() {
  local flag="$1" project="$2" paths=() path
  [ -d "$project" ] || { echo "sbx-up: not a directory: $project" >&2; exit 1; }
  project="$(cd -P "$project" && pwd)"
  while IFS= read -r path; do paths+=("$path"); done < <(existing_lock_paths "$project")
  [ ${#paths[@]} -gt 0 ] || return 0
  if ! command -v chflags >/dev/null 2>&1; then
    echo "sbx-up: chflags not found (macOS only), cannot lock ${paths[*]} in $project" >&2
    exit 1
  fi
  ( cd "$project" && run chflags -R "$flag" "${paths[@]}" ) ||
    { echo "sbx-up: chflags $flag failed in $project, not continuing" >&2; exit 1; }
}

# Shortens a path under $HOME for display.
#   /Users/me/projects/shop  =>  ~/projects/shop
tilde() {
  case "$1" in
    "$HOME"/*) printf '~%s\n' "${1#"$HOME"}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# Shows what is about to start and asks on the terminal; exits unless the answer is y or yes.
# Skipped with -y and for -n. Reads globals NAME, PROJECT, REPO, KITS, REUSE, EXISTS, SEALED.
confirm() {
  local action="create" first=1 item answer locks
  if [ -n "$REUSE" ]; then
    action="reuse"
  elif [ -n "$EXISTS" ]; then
    action="remove and create again"
  fi
  {
    printf 'sandbox  %s (%s)\n' "$NAME" "$action"
    printf 'mounts   %s\n' "$(tilde "$PROJECT")"
    if [ -n "$REUSE" ]; then
      printf 'kits     as created (sbx-up -r to apply the current ones)\n'
    else
      for item in "$REPO/shell-base" "${KITS[@]}"; do
        [ "$item" != "--kit" ] || continue
        if [ -n "$first" ]; then printf 'kits     %s\n' "$(tilde "$item")"; first=""
        else printf '         %s\n' "$(tilde "$item")"; fi
      done
    fi
    if [ -z "$SEALED" ]; then
      locks="$(existing_lock_paths "$PROJECT" | tr '\n' ' ')"
      [ -z "$locks" ] || printf 'locks    %s\n' "${locks% }"
    fi
    printf 'Start? [y/N] '
  } >&2
  if ! { exec 3</dev/tty; } 2>/dev/null; then
    echo >&2
    echo "sbx-up: no terminal to confirm on; pass -y to start without asking" >&2
    exit 1
  fi
  read -r answer <&3 || answer=""
  exec 3<&-
  case "$answer" in
    y|Y|yes|YES|Yes) ;;
    *) echo "sbx-up: not started" >&2; exit 1 ;;
  esac
}

run() {
  if [ -n "$DRY_RUN" ]; then
    printf '%q ' "$@"
    printf '\n'
  else
    "$@"
  fi
}

# Copies every mixin of project-template/.sbx-kits/ into a project's .sbx-kits/, skipping the ones
# the project already has.
#   copy_template ~/projects/shop   => ~/projects/shop/.sbx-kits/project/project.yaml
copy_template() {
  local project="$1" src="$REPO/project-template/.sbx-kits" dir name copied=""
  [ -d "$project" ] || { echo "sbx-up: not a directory: $project" >&2; exit 1; }
  project="$(cd -P "$project" && pwd)"
  for dir in "$src"/*/; do
    [ -d "$dir" ] || continue
    dir="${dir%/}"
    name="$(basename "$dir")"
    if [ -e "$project/.sbx-kits/$name" ]; then
      echo "sbx-up: $project/.sbx-kits/$name exists, left alone" >&2
      continue
    fi
    run mkdir -p "$project/.sbx-kits"
    run cp -R "$dir" "$project/.sbx-kits/$name"
    copied=1
  done
  if [ -n "$copied" ] && [ -z "$DRY_RUN" ]; then
    echo "sbx-up: copied the template to $project/.sbx-kits/" >&2
    echo "sbx-up: edit .sbx-kits/*/*.yaml, commit it with the project, then run sbx-up shell|claude" >&2
  fi
}

DRY_RUN=""
REBUILD=""
YES=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n) DRY_RUN=1; shift ;;
    -r) REBUILD=1; shift ;;
    -y) YES=1; shift ;;
    -h|--help) usage 0 ;;
    *) break ;;
  esac
done

REPO="$(repo_root)"

SEALED=""
SEALED_NAME=""
SEALED_KEEP=""
case "${1:-}" in
  shell|claude)
    FLAVOR="$1"
    shift
    ;;
  sealed)
    SEALED=1
    shift
    while [ $# -gt 0 ]; do
      case "$1" in
        -c)
          [ $# -ge 2 ] || usage
          SEALED_NAME="$(slug "$2")"
          [ -n "$SEALED_NAME" ] || { echo "sbx-up: not a usable sandbox name: $2" >&2; exit 1; }
          shift 2
          ;;
        -k) SEALED_KEEP=1; shift ;;
        *) break ;;
      esac
    done
    FLAVOR="${1:-}"
    case "$FLAVOR" in shell|claude) shift ;; *) usage ;; esac
    ;;
  kit)
    shift
    [ $# -le 1 ] || usage
    copy_template "${1:-$PWD}"
    exit 0
    ;;
  unlock)
    shift
    [ $# -le 1 ] || usage
    set_lock nouchg "${1:-$PWD}"
    [ -n "$DRY_RUN" ] || echo "sbx-up: unlocked; the next sbx-up start locks them again" >&2
    exit 0
    ;;
  *) usage ;;
esac

if [ -n "$SEALED" ]; then
  # A fixed, emptied directory instead of the project: nothing from the host is mounted.
  NAME="sealed-$FLAVOR${SEALED_NAME:+-$SEALED_NAME}"
  PROJECT="${XDG_CACHE_HOME:-$HOME/.cache}/sbx-up/$NAME"
else
  PROJECT="$PWD"
  if [ $# -gt 0 ] && [ "$1" != "--" ]; then
    PROJECT="$1"
    shift
  fi
  [ -d "$PROJECT" ] || { echo "sbx-up: not a directory: $PROJECT" >&2; exit 1; }
  PROJECT="$(cd -P "$PROJECT" && pwd)"
  NAME="$(sandbox_name "$PROJECT" "$FLAVOR")"
fi

ARGS=()
if [ $# -gt 0 ]; then
  [ "$1" = "--" ] || usage
  shift
  ARGS=("$@")
fi

KITS=()
if [ "$FLAVOR" = shell ]; then
  # A login bash, so the login profile runs.
  [ ${#ARGS[@]} -gt 0 ] || ARGS=(-l)
else
  # claude adds Docker's claude-mixin, pinned in claude-mixin.ref.
  MIXIN_REF="$(grep -v '^[[:space:]]*\(#\|$\)' "$REPO/claude-mixin.ref" | head -n 1)"
  [ -n "$MIXIN_REF" ] || { echo "sbx-up: no reference in $REPO/claude-mixin.ref" >&2; exit 1; }
  KITS+=(--kit "$MIXIN_REF")
  [ ${#ARGS[@]} -gt 0 ] || ARGS=(-lc 'claude --permission-mode auto')
fi

if [ -z "$SEALED" ] && [ -d "$PROJECT/.sbx-kits" ]; then
  for dir in "$PROJECT"/.sbx-kits/*/; do
    [ -d "$dir" ] || continue
    dir="${dir%/}"
    if [ -f "$dir/$(basename "$dir").yaml" ]; then
      KITS+=(--kit "$dir")
    else
      echo "sbx-up: skipping $dir (no $(basename "$dir").yaml inside)" >&2
    fi
  done
fi

EXISTS=""
if sbx ls -q 2>/dev/null | grep -qxF "$NAME"; then
  EXISTS=1
fi

# Reuse: `sbx run --name` restarts and attaches to the existing sandbox (see below). sealed reuses
# only with -k; without it, a kept or left-behind sandbox is replaced.
REUSE=""
if [ -n "$EXISTS" ] && [ -z "$REBUILD" ] && { [ -z "$SEALED" ] || [ -n "$SEALED_KEEP" ]; }; then
  REUSE=1
fi

[ -n "$YES" ] || [ -n "$DRY_RUN" ] || confirm

# A fresh sealed start empties its workspace (a kept one being reused keeps it, and only gets it
# back if it went missing).
if [ -n "$SEALED" ]; then
  [ -n "$REUSE" ] || run rm -rf "${PROJECT:?}"
  run mkdir -p "$PROJECT"
fi

# Everything from here on, sbx included, runs in the workspace, so tmux (#{pane_current_path} in
# tmux/agent.conf) names the window after the project or sealed-<flavor>, not the launch directory.
run cd "$PROJECT"

# Makes .git/hooks, .git/config and .sbx-kits/ read-only for the sandbox (see the header). Sealed
# sandboxes mount an empty directory, so there is nothing to lock.
[ -n "$SEALED" ] || set_lock uchg "$PROJECT"

# Reuse reads the sandbox's kits and workspace from its spec. Kits are left out on purpose: passing
# a kit with build content would make sbx create the sandbox fresh. ARGS still go along, so
# `claude` starts Claude Code.
if [ -n "$REUSE" ]; then
  if [ -n "$SEALED" ]; then
    echo "sbx-up: reusing sandbox $NAME (sbx-up -r sealed -k ... to start it fresh)" >&2
  else
    echo "sbx-up: reusing sandbox $NAME (sbx-up -r $FLAVOR to rebuild it from the current kits)" >&2
  fi
  CMD=(sbx run --name "$NAME")
  [ ${#ARGS[@]} -eq 0 ] || CMD+=(-- "${ARGS[@]}")
  if [ -n "$DRY_RUN" ]; then
    run "${CMD[@]}"
    exit 0
  fi
  exec "${CMD[@]}"
fi

if [ -n "$EXISTS" ]; then
  echo "sbx-up: removing existing sandbox $NAME" >&2
  run sbx rm -f "$NAME"
fi

CMD=(sbx run --name "$NAME")
# sealed: --rm (sbx 0.47.0+) removes the sandbox once the agent session exits; -k leaves it out so
# the sandbox stays for the next `sealed -k`. sbx-up still execs sbx, since tmux/agent.conf tells
# sandbox panes apart by their foreground process being `sbx`. A sandbox left behind by an
# interrupted run is removed above on the next sealed start, and the workspace was emptied
# before the skills step.
[ -z "$SEALED" ] || [ -n "$SEALED_KEEP" ] || CMD+=(--rm)
[ ${#KITS[@]} -eq 0 ] || CMD+=("${KITS[@]}")
CMD+=("$REPO/shell-base" "$PROJECT")
[ ${#ARGS[@]} -eq 0 ] || CMD+=(-- "${ARGS[@]}")

if [ -n "$DRY_RUN" ]; then
  run "${CMD[@]}"
else
  exec "${CMD[@]}"
fi
