#!/usr/bin/env bash
# install-skills - copy this repo's agent skills into the skills folder sbx mounts into sandboxes.
#
# Run on the host, not inside a sandbox. sbx mounts its own folder
#   ~/Library/Application Support/com.docker.sandboxes/sandboxes/agent-skills
# read-only at /home/agent/.claude/skills in every sandbox (not the host's ~/.claude/skills), which
# also hides any skill the image ships there. Skills copied into that folder show up in every
# sandbox. sbx-up runs this before each sandbox start, so running it by hand is rarely needed.
#
#   install-skills [-n] [-q] [DIR]
#
#   DIR   skills folder to install into (default: $SBX_SKILLS_DIR, else the sbx folder above)
#   -n    print what would be copied instead of copying
#   -q    only print skills that were (or would be) copied
#
# Every directory config/skills/<name>/ that holds a SKILL.md is copied to DIR/<name>/. Files that
# are already identical are left alone; a changed skill is replaced by this repo's version.
#
# Example: `install-skills` with config/skills/scan-dependencies/SKILL.md installs
#   ~/Library/Application Support/com.docker.sandboxes/sandboxes/agent-skills/scan-dependencies/SKILL.md
set -eo pipefail

usage() {
  sed -n '2,/^set -eo/{/^set -eo/d;s/^# \{0,1\}//;p;}' "$0" >&2
  exit "${1:-2}"
}

# Follows symlinks to this script, then returns the repo root (the parent of bin/).
#   /usr/local/bin/install-skills -> ~/projects/sandbox-templates/bin/install-skills
#   => ~/projects/sandbox-templates
repo_root() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")/.." && pwd
}

DRY_RUN=""
QUIET=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n) DRY_RUN=1; shift ;;
    -q) QUIET=1; shift ;;
    -h|--help) usage 0 ;;
    -*) usage ;;
    *) break ;;
  esac
done
[ $# -le 1 ] || usage

# Inside a sandbox ~/.claude/skills is that read-only mount; installing there cannot work.
if [ -z "$DRY_RUN" ] && [ -z "$1" ] && mount 2>/dev/null | grep -q " on ${HOME}/.claude/skills type virtiofs"; then
  echo "install-skills: looks like a sandbox (~/.claude/skills is a host mount); run this on the host" >&2
  exit 1
fi

TARGET="${1:-${SBX_SKILLS_DIR:-$HOME/Library/Application Support/com.docker.sandboxes/sandboxes/agent-skills}}"
# sbx creates the folder's parent; without it sbx is probably not installed or keeps it elsewhere.
if [ -z "$1" ] && [ -z "$SBX_SKILLS_DIR" ] && [ ! -d "$(dirname "$TARGET")" ]; then
  echo "install-skills: no sbx folder at $(dirname "$TARGET"); is sbx installed? Set SBX_SKILLS_DIR or pass DIR" >&2
  exit 1
fi
SOURCE="$(repo_root)/config/skills"
[ -d "$SOURCE" ] || { echo "install-skills: no skills directory at $SOURCE" >&2; exit 1; }

found=0
for dir in "$SOURCE"/*/; do
  [ -f "$dir/SKILL.md" ] || continue
  dir="${dir%/}"
  name="$(basename "$dir")"
  found=1
  if [ -d "$TARGET/$name" ] && diff -rq "$dir" "$TARGET/$name" >/dev/null 2>&1; then
    [ -n "$QUIET" ] || echo "$name: up to date"
    continue
  fi
  if [ -n "$DRY_RUN" ]; then
    echo "$name: would copy $dir -> $TARGET/$name"
    continue
  fi
  mkdir -p "$TARGET"
  rm -rf "${TARGET:?}/$name"
  cp -R "$dir" "$TARGET/$name"
  echo "$name: installed to $TARGET/$name"
done

[ "$found" = 1 ] || { echo "install-skills: no skill with a SKILL.md under $SOURCE" >&2; exit 1; }
