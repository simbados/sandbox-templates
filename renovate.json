{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      // TEMPORARY: throttling fnm updates while we're actively testing the
      // hash-update pipeline against it. Remove this rule once done.
      "matchDepNames": ["Schniz/fnm"],
      "prHourlyLimit": 10
    },
    {
      // Generated Dockerfiles are build artifacts (scripts/generate_dockerfile.py)
      // assembled from template.yaml + tools/*.dockerfile fragments. base_image
      // is managed via the customManager below instead, so the default
      // dockerfile manager must never edit FROM lines here directly - a later
      // regenerate would silently overwrite (revert) any bump it made.
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["**/Dockerfile"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)template\\.yaml$/"
      ],
      "matchStrings": [
        "base_image:\\s*(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)tools/.*\\.dockerfile$/"
      ],
      "matchStrings": ["FNM_VERSION=(?<currentValue>v[0-9.]+);"],
      "depNameTemplate": "Schniz/fnm",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)tools/.*\\.dockerfile$/"
      ],
      "matchStrings": ["FZF_VERSION=(?<currentValue>v[0-9.]+);"],
      "depNameTemplate": "junegunn/fzf",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)tools/.*\\.dockerfile$/"
      ],
      "matchStrings": ["ZOXIDE_VERSION=(?<currentValue>v[0-9.]+);"],
      "depNameTemplate": "ajeetdsouza/zoxide",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      // temurin25-binaries is version-25-specific (Adoptium publishes a separate repo per
      // major), so this only ever tracks patch/build releases within Java 25 LTS - moving to
      // a later LTS means manually repointing depNameTemplate at the new major's repo.
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)tools/.*\\.dockerfile$/"
      ],
      "matchStrings": ["TEMURIN_VERSION=(?<currentValue>jdk-[0-9.]+\\+[0-9]+);"],
      "depNameTemplate": "adoptium/temurin25-binaries",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)tools/.*\\.dockerfile$/"
      ],
      "matchStrings": ["UV_VERSION=(?<currentValue>[0-9.]+);"],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
