{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      // The mise binary (MISE_VERSION in tools/mise.dockerfile, tracked by the customManager
      // below) releases almost daily, faster than minimumReleaseAge (7 days), so the PR
      // Renovate opens can get stuck on the first version that cleared the age check instead
      // of the newest one that has (see
      // https://github.com/renovatebot/renovate/discussions/42643). Forcing a close+recreate
      // instead of an in-place branch update makes Renovate re-run the full minimumReleaseAge
      // evaluation each time.
      //
      // schedule turns this into a predictable weekly cycle instead of continuous churn:
      // Renovate only touches it outside this window if the branch needs a rebase, never to
      // propose a new version. Close the PR during that window if the version it landed on
      // isn't the one you want yet - recreateWhen brings it right back, freshly re-evaluated
      // against minimumReleaseAge, rather than leaving it closed (the default "ignore this
      // version forever" behavior).
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["jdx/mise"],
      "schedule": ["before 4am on monday"],
      "recreateWhen": "always"
    },
    {
      // The sandbox-templates base images use non-version tags (e.g. "shell-docker"), so Renovate has no matching version to age a digest
      // update against. Since Renovate 42 (minimumReleaseAgeBehaviour defaults to
      // "timestamp-required") such digest updates are held as "Pending Status
      // Checks" on the Dependency Dashboard forever - see "digest updates" in
      // docs/usage/key-concepts/minimum-release-age.md. Raise them without an age
      // check instead; minimumReleaseAge still applies to everything else.
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker/sandbox-templates"],
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      // Generated Dockerfiles are build artifacts (scripts/generate_dockerfile.py)
      // assembled from template.yaml + tools/*.dockerfile fragments. base_image
      // is managed via the customManager below instead, so the default
      // dockerfile manager must never edit FROM lines here directly - a later
      // regenerate would silently overwrite (revert) any bump it made. Kit templates
      // generate <template>/<template>.dockerfile instead of Dockerfile; tools/*.dockerfile
      // fragments have no FROM line, so matching them too changes nothing.
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["**/Dockerfile", "**/*.dockerfile"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      // Docker's claude-mixin kit, composed onto shell-base by `bin/sbx-up claude`. The file
      // holds one `repo:tag@digest` line; tags are Claude Code versions (2.1.285), so the
      // docker versioning picks the newest release and keeps the digest pinned to it.
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)claude-mixin\\.ref$/"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9./_-]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)template\\.yaml$/"
      ],
      "matchStrings": [
        "base_image:\\s*(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      // Pins the mise binary itself (tools/mise.dockerfile) - separate from the tools mise
      // manages, which Renovate's native `mise` manager tracks directly in
      // shell-base/mise.toml (no customManager needed for those).
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)tools/mise\\.dockerfile$/"
      ],
      "matchStrings": ["MISE_VERSION=(?<currentValue>[0-9.]+);"],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
