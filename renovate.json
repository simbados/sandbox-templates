{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "7 days",
  // One PR a week: every update that has passed its minimumReleaseAge by Monday morning (UTC) is
  // grouped into a single branch, majors included. The lockfile and pins stay, so the hash
  // workflow refreshes them on that one PR as before. Outside the window Renovate still keeps an
  // open PR up to date, but opens no new one.
  "schedule": ["before 6am on monday"],
  "separateMajorMinor": false,
  // Renovate merges the weekly PR itself once every check on it has passed, i.e. after
  // update-hashes.yml has refreshed and committed the pins (it marks that commit as passed). Not
  // GitHub's native auto-merge: without a required check in branch protection, that could merge
  // before the workflow has committed the refreshed hashes.
  "automerge": true,
  "platformAutomerge": false,
  // .github/workflows/update-hashes.yml commits refreshed lockfiles and regenerated Dockerfiles
  // onto Renovate's branches. Without this, Renovate counts those commits as manual edits and
  // stops updating the branch ("PR Edited (Blocked)" on the Dependency Dashboard), so the PR
  // stays on its first version. The workflow re-runs on every Renovate push.
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "packageRules": [
    {
      // Everything in one weekly PR (see schedule above).
      "matchPackageNames": ["*"],
      "groupName": "weekly updates",
      "groupSlug": "weekly"
    },
    {
      // The mise binary (MISE_VERSION in tools/mise.dockerfile, tracked by the customManager
      // below) releases almost daily, so it waits 3 days instead of the global 7 to not trail
      // the newest release by too much.
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["jdx/mise"],
      "minimumReleaseAge": "3 days"
    },
    {
      // The tools in shell-base/mise.toml (node, hunk, helix, uv), tracked by Renovate's
      // native mise manager, wait 3 days like the mise binary instead of the global 7.
      "matchManagers": ["mise"],
      "minimumReleaseAge": "3 days"
    },
    {
      // node is pinned to an exact version like the other tools. With node = "lts" its updates
      // touched only mise.lock, and Renovate rebuilds a branch from main on every run when it
      // mixes such a lockfile-only update with version bumps from the same file. That discarded
      // update-hashes.yml's commit each time, in a loop (PR #49). Even majors only, so the pin
      // stays on LTS lines (24, 26, ...) and skips the odd, short-lived releases.
      "matchManagers": ["mise"],
      "matchDepNames": ["node"],
      "allowedVersions": "/^v?\\d*[02468]\\./"
    },
    {
      // Docker Hardened Images overwrite a version tag when they rebuild it (e.g. sbx/shell:1.1.0
      // with security fixes), so the same tag gets new digests that have no release timestamp.
      // Since Renovate 42 (minimumReleaseAgeBehaviour defaults to "timestamp-required") such
      // digest updates are held as "Pending Status Checks" on the Dependency Dashboard forever -
      // see "digest updates" in docs/usage/key-concepts/minimum-release-age.md. Raise them
      // without an age check instead; minimumReleaseAge still applies to new versions.
      "matchDatasources": ["docker"],
      "matchPackageNames": ["sbx/shell", "sbx/claude-mixin"],
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      // Generated Dockerfiles are build artifacts (scripts/generate_dockerfile.py)
      // assembled from template.yaml + tools/*.dockerfile fragments. base_image
      // is managed via the customManager below instead, so the default
      // dockerfile manager must never edit FROM lines here directly - a later
      // regenerate would silently overwrite (revert) any bump it made. Kit templates
      // generate <template>/<template>.dockerfile instead of Dockerfile; tools/*.dockerfile
      // fragments have no FROM line, so matching them too changes nothing.
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["**/Dockerfile", "**/*.dockerfile"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      // Docker's claude-mixin kit (sbx/claude-mixin, a Docker Hardened Image; it replaced
      // docker/sbx-kit-claude-mixin, which Docker deleted), composed onto shell-base by `bin/sbx-up claude`. The file
      // holds one `repo:tag@digest` line. Its tags are Claude Code versions (2.1.285), so the
      // docker versioning picks the newest release and keeps the digest pinned to it.
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)claude-mixin\\.ref$/"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9./_-]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)template\\.yaml$/"
      ],
      "matchStrings": [
        "base_image:\\s*(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      // Pins the mise binary itself (tools/mise.dockerfile) - separate from the tools mise
      // manages, which Renovate's native `mise` manager tracks directly in
      // shell-base/mise.toml (no customManager needed for those).
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)tools/mise\\.dockerfile$/"
      ],
      "matchStrings": ["MISE_VERSION=(?<currentValue>[0-9.]+);"],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
