{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      // TEMPORARY: throttling fnm updates while we're actively testing the
      // hash-update pipeline against it. Remove this rule once done.
      "matchDepNames": ["Schniz/fnm"],
      "prHourlyLimit": 10
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": ["FNM_VERSION=(?<currentValue>v[0-9.]+);"],
      "depNameTemplate": "Schniz/fnm",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": ["FZF_VERSION=(?<currentValue>v[0-9.]+);"],
      "depNameTemplate": "junegunn/fzf",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": ["ZOXIDE_VERSION=(?<currentValue>v[0-9.]+);"],
      "depNameTemplate": "ajeetdsouza/zoxide",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      // temurin25-binaries is version-25-specific (Adoptium publishes a separate repo per
      // major), so this only ever tracks patch/build releases within Java 25 LTS - moving to
      // a later LTS means manually repointing depNameTemplate at the new major's repo.
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": ["TEMURIN_VERSION=(?<currentValue>jdk-[0-9.]+\\+[0-9]+);"],
      "depNameTemplate": "adoptium/temurin25-binaries",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
